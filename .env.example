# Banco — Supabase/Neon em prod, docker local em dev
DATABASE_URL="postgresql://tutorpass:tutorpass@localhost:5432/tutorpass?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3333
NODE_ENV=development
# Auth
JWT_ACCESS_SECRET="troque-por-um-segredo-longo"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30
# QR dinâmico
QR_TOKEN_SECRET="troque-por-outro-segredo-longo"
QR_WINDOW_SECONDS=30
# Storage de selfies/fotos (S3-compatível / Supabase Storage)
S3_ENDPOINT=""
S3_BUCKET="tutorpass-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
CORS_ORIGINS="http://localhost:3000"
