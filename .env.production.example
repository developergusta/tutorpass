# Produção no VPS — copie p/ .env.production e preencha. NUNCA commite o
# arquivo preenchido. Gere cada segredo com: openssl rand -hex 32

# Endereço público do site. Sem domínio ainda? Use o IP do VPS:
#   SITE_ADDRESS=:80
#   PUBLIC_ORIGIN=http://IP-DO-VPS
# Com domínio (DNS já apontando p/ o VPS), o Caddy emite HTTPS sozinho:
#   SITE_ADDRESS=tutorpass.seudominio.com.br
#   PUBLIC_ORIGIN=https://tutorpass.seudominio.com.br
SITE_ADDRESS=:80
PUBLIC_ORIGIN=http://IP-DO-VPS

# Segredos (um valor diferente p/ cada um)
POSTGRES_PASSWORD=troque-por-um-segredo-longo
REDIS_PASSWORD=troque-por-um-segredo-longo
JWT_ACCESS_SECRET=troque-por-um-segredo-longo
QR_TOKEN_SECRET=troque-por-um-segredo-longo
