# TutorPass API — variáveis de ambiente (EXEMPLO, sem valores reais)
# Copie para `.env` (local) ou cadastre no painel do provedor (produção).
# NUNCA commite o `.env` real nem cole segredos em chats/prints.

# --- Banco e cache (produção: Neon Postgres + Upstash Redis) ---
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/BANCO?schema=public"
REDIS_URL="rediss://USUARIO:SENHA@HOST:6379"

# --- Servidor ---
PORT=3333
NODE_ENV=production
# Origens do web separadas por vírgula (sem barra no fim)
CORS_ORIGINS="https://SEU-WEB.vercel.app"

# --- Auth (gere segredos longos e aleatórios; ex.: openssl rand -hex 32) ---
JWT_ACCESS_SECRET="TROQUE-POR-UM-SEGREDO-LONGO-E-ALEATORIO"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# --- QR dinâmico anti-fraude ---
QR_TOKEN_SECRET="TROQUE-POR-OUTRO-SEGREDO-LONGO-E-ALEATORIO"
QR_WINDOW_SECONDS=30

# --- Storage de selfies/fotos (S3-compatível / Supabase Storage) ---
S3_ENDPOINT=""
S3_BUCKET="tutorpass-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
